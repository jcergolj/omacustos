# Maintainer: OmaCustos contributors

pkgname=omacustos-git
pkgver=0.1.r42.g329cbc4
pkgrel=1
pkgdesc='OmaCustos: an Omarchy backup client for Proton Drive'
arch=('x86_64')
url='https://github.com/jcergolj/omacustos'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'libarchive' 'zlib')
makedepends=('cmake' 'gcc')
optdepends=('proton-drive: Proton Drive CLI used for backup storage'
            'xdg-terminal-exec: Open the Proton CLI sign-in in your preferred terminal')
provides=('omacustos')
conflicts=('omacustos')
install='omacustos.install'
source=("$pkgname::git+$url.git"
        'omacustos.desktop'
        'omacustos.svg'
        'omacustos.service'
        'omacustos.timer'
        'LICENSE')
sha256sums=('SKIP'
            '883fa94e118c967214d7a7b534bddac82a703f7f4e837c1a7a7410383a4aebf3'
            '616d6c84dd51458faa4fecf561357c33ff48d0c30054017891e1908d679890e9'
            'a039801ce578f61cd675b24f9bb4006b103b009cb4033492c645ec3198022d1e'
            '711efd1dbcab87bf065c7a7c010b893fa4d78ca6798fab7427293c3becc87a64'
            'e1417669d8da98bc3f2ff4ad7bd24b5913326833cc91750eab4e6711a21d3a91')

pkgver() {
    cd "$srcdir/$pkgname"
    printf '0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S "$srcdir/$pkgname/native" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --target omacustos omacustos-worker
}

package() {
    install -Dm755 "$srcdir/build/omacustos" "$pkgdir/usr/bin/omacustos"
    install -Dm755 "$srcdir/build/omacustos-worker" "$pkgdir/usr/bin/omacustos-worker"
    install -Dm644 "$srcdir/omacustos.desktop" \
        "$pkgdir/usr/share/applications/omacustos.desktop"
    install -Dm644 "$srcdir/omacustos.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacustos.svg"
    install -Dm644 "$srcdir/omacustos.service" \
        "$pkgdir/usr/lib/systemd/user/omacustos.service"
    install -Dm644 "$srcdir/omacustos.timer" \
        "$pkgdir/usr/lib/systemd/user/omacustos.timer"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
